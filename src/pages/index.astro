---
import TournamentTable from "#/components/TournamentTable.astro";
import { tourneys } from "#/data/tourneys.ts";
import "#/styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width">
		<meta name="generator" content={Astro.generator}>
		<title>Agatem's Tournament History</title>
	</head>
	<body class="bg-neutral-950">
		<div class="w-full px-4 py-8">
			<header class="mb-6">
				<h1 class="text-3xl font-bold text-neutral-100">
					Agatem's Tournament History
				</h1>
			</header>

			<main class="overflow-x-auto">
				<TournamentTable tourneys={tourneys} />
			</main>
		</div>
	</body>
</html>
